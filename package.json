{
  "name": "advanced-line-range-selection",
  "displayName": "Advanced Line Range Selection",
  "description": "Select text ranges using line numbers with character, column, or proportional positions, negative indexing, Unicode grapheme-aware boundaries, and configurable snapping.",
  "version": "1.2.0",
  "icon": "assets/icon.png",
  "publisher": "orfadida",
  "author": {
    "name": "Or Fadida",
    "email": "or@fadida.net"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/orfadida2000/advanced-line-range-selection.git"
  },
  "bugs": {
    "url": "https://github.com/orfadida2000/advanced-line-range-selection/issues"
  },
  "engines": {
    "vscode": "^1.68.0"
  },
  "keywords": [
    "text selection",
    "line selection",
    "range selection",
    "advanced selection",
    "character selection",
    "column selection",
    "proportional selection",
    "select lines",
    "line range",
    "selection",
    "editor"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:advanced-line-range-selection.selectLineRange"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "configuration": {
      "title": "Advanced Line Range Selection",
      "properties": {
        "advanced-line-range-selection.coordinateMode": {
          "type": "string",
          "enum": [
            "character",
            "column"
          ],
          "enumDescriptions": [
            "Treat ':' coordinates as 1-based user-perceived character numbers using Unicode grapheme clusters. Explicit character endpoints are inclusive.",
            "Treat ':' coordinates as 1-based text positions between Unicode grapheme clusters. Column 1 is the beginning of the line."
          ],
          "default": "character",
          "scope": "resource",
          "description": "Controls how integer secondary coordinates introduced by ':' are interpreted."
        },
        "advanced-line-range-selection.proportionSnap": {
          "type": "string",
          "enum": [
            "nearest",
            "before",
            "after"
          ],
          "enumDescriptions": [
            "Snap a proportional position to the nearest Unicode grapheme boundary. If both surrounding boundaries are equally close, use the boundary after the requested position.",
            "Snap a proportional position to the nearest Unicode grapheme boundary at or before the requested position.",
            "Snap a proportional position to the nearest Unicode grapheme boundary at or after the requested position."
          ],
          "default": "nearest",
          "scope": "resource",
          "description": "Controls how proportional positions are snapped when the requested position falls between Unicode grapheme boundaries."
        }
      }
    },
    "commands": [
      {
        "command": "advanced-line-range-selection.selectLineRange",
        "title": "Select Line Range",
        "category": "Advanced Line Range Selection"
      }
    ],
    "keybindings": [
      {
        "command": "advanced-line-range-selection.selectLineRange",
        "key": "ctrl+[ ctrl+]",
        "mac": "cmd+[ cmd+]",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "advanced-line-range-selection.selectLineRange"
        }
      ],
      "editor/context": [
        {
          "command": "advanced-line-range-selection.selectLineRange",
          "when": "editorTextFocus",
          "group": "selection@1"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^16.18.0",
    "@types/vscode": "1.68.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2"
  }
}
